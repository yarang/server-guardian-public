[Unit]
Description=Server Guardian hub decision DB backup
Documentation=https://git.example.com/owner/server-guardian
# The replica copy uses the fleet key through the ssh-agent (IdentityAgent in ~/.ssh/config).
Wants=guardian-fleet-agent.service
After=guardian-fleet-agent.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/.guardian/current/cli/llm-agent
# GUARDIAN_BACKUP_REPLICA=<host> sends each backup off the hub (see db_backup.py).
# Besides the DB copy it writes a data dir tarball and reads ~/.ssh/guardian_fleet.conf and
# ~/.ssh/guardian_known_hosts (never a private key; the keys stay under InaccessiblePaths).
# Restore: docs/operations/backup-restore.md
EnvironmentFile=-/home/ubuntu/.guardian/backup.env
ExecStart=/usr/bin/python3 /home/ubuntu/.guardian/current/cli/llm-agent/db_backup.py --keep 14

NoNewPrivileges=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
InaccessiblePaths=-/etc/guardian -/home/ubuntu/.ssh/guardian_fleet -/home/ubuntu/.ssh/id_ed25519 -/home/ubuntu/.ssh/id_rsa -/home/ubuntu/.guardian/agent.env -/home/ubuntu/.guardian/llm.env
ProtectSystem=full
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
UMask=0077
